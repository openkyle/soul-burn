<section class="soul-burn-action-panel">
  <header class="soul-burn-action-heading">
    <div>
      <h2><i class="fas fa-fire-flame-curved"></i> Soul Burn</h2>
      <p>{{actorName}} is Soul Burnin'. These actions vanish when the transformation ends.</p>
    </div>
    {{#if tracked}}
      <span class="soul-burn-rounds">Rounds {{startedRound}}–{{lastRound}}</span>
    {{/if}}
  </header>

  <div class="soul-burn-action-list">
    {{#each actions}}
      <article class="soul-burn-action-row" data-item-id="{{id}}">
        <img src="{{img}}" alt="{{name}}">
        <button type="button" data-soul-burn-action="{{action}}" title="Use {{name}}">
          <strong>{{name}}</strong>
          {{#if activation}}<small>{{activation}}</small>{{/if}}
        </button>
        {{#if hasUses}}
          <span class="soul-burn-action-uses">{{uses}} / {{maxUses}}</span>
        {{else}}
          <span class="soul-burn-action-uses">Ready</span>
        {{/if}}
      </article>
    {{else}}
      <p class="notification warning">Soul Burn actions are being prepared. Reopen the sheet if they do not appear.</p>
    {{/each}}
  </div>
</section>
